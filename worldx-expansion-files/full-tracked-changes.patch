+        if (node) {
+          // Decrement remaining count
+          node.remaining = Math.max(0, node.remaining - 1);
+        }
+
+        // Update build state with new resources
+        if (this.buildState) {
+          this.buildState.resources = result.resources;
+        }
+
+        this.eventBus.emit("resource_collected", {
